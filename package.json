{
  "name": "yueyin-admin-dashboard",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build",
    "preview": "vite preview --port 4174",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{vue,js,css}\" index.html eslint.config.js",
    "server:dev": "npm --prefix server run start:dev",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server run test",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.1.0",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.5.0",
    "sharp": "^0.35.4",
    "vite": "^8.2.0"
  }
}
